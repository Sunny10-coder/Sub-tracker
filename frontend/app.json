{
  "expo": {
    "name": "SubMind",
    "slug": "frontend",
    "version": "2.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "submind",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.subscriptionvault.z533ca",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan subscription screenshots and receipts",
        "NSPhotoLibraryUsageDescription": "Import subscription screenshots to extract details",
        "NSMicrophoneUsageDescription": "Ask SubMind questions using your voice"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.submind.metro",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES"
      ],
      "versionCode": 5
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#141319"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Import subscription screenshots to extract details",
          "cameraPermission": "Scan subscription screenshots and receipts"
        }
      ],
      "@react-native-vector-icons/material-design-icons",
      "@react-native-google-signin/google-signin",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain"
            ],
            "multipleShareMimeTypes": []
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
